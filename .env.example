# ============================================================
#  重描 · 配置
#  改完这个文件要重启服务（Ctrl+C 后重新 npm start）
#  这里的所有 Key 只留在服务端，不会发送到浏览器
# ============================================================

# ---------- 服务 ----------
PORT=5180
# 默认只监听本机。要给别人访问改成 0.0.0.0（同时记得配置 HTTPS）
HOST=127.0.0.1
MAX_UPLOAD_MB=12

# ---------- 第一层：DeepSeek，负责读图与写画稿 ----------
# 申请地址 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=45000
DEEPSEEK_TEMPERATURE=0.85

# ---------- 第二层：图像模型，负责落笔 ----------
# 可选值：openai-edit | openai-generate | stability | demo
#   openai-edit      标准图生图（multipart /images/edits），OpenAI gpt-image-1 用这个
#   openai-generate  文生图接口，部分厂商接受 image 字段当参考图（国内多数走这条）
#   stability        Stability SD3.5 的 image-to-image
#   demo             不调用任何接口，界面里用内置笔触引擎
IMAGE_PROVIDER=demo
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=

# 留空则按原图比例自动选 1024x1024 / 1536x1024 / 1024x1536
IMAGE_SIZE=
# 尺寸参数名。多数厂商叫 size，硅基流动 / 阿里百炼叫 image_size
IMAGE_SIZE_FIELD=size
# openai-generate 模式下是否把参考图放进请求体
IMAGE_PASSTHROUGH=true
# 仅 stability 使用：0.1 只改一点，0.95 几乎重画
IMAGE_STRENGTH=0.62
IMAGE_TIMEOUT_MS=120000

# 留给厂商私有参数，会被合并进请求体。例如：
# IMAGE_EXTRA_JSON={"image_size":"1024x1024","num_inference_steps":30,"guidance_scale":7.5}
IMAGE_EXTRA_JSON=

# ============================================================
#  三个可直接抄的配置组合
# ============================================================
#
# 【A】OpenAI 官方（需要能访问 api.openai.com）
# IMAGE_PROVIDER=openai-edit
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY=high
#
# 【B】硅基流动（国内可直连，具体模型名与参数以官网为准）
# IMAGE_PROVIDER=openai-generate
# IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_MODEL=Kwai-Kolors/Kolors
# IMAGE_SIZE_FIELD=image_size
#
# 【C】Stability SD3.5 图生图
# IMAGE_PROVIDER=stability
# IMAGE_BASE_URL=https://api.stability.ai
# IMAGE_MODEL=sd3.5-large
# IMAGE_STRENGTH=0.7
